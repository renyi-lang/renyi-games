module text_view
  purpose: A frame of rectangles and labels sampled into a grid of characters, for tests and text.

import std.screen exposing Colour, Shape

let ramp: List of Text be [" ", ".", ":", "-", "=", "+", "*", "#", "%", "@"]
  purpose: The characters from dark to bright that stand for a colour.

public type Grid
  purpose: A character grid over the logical screen: its cells row by row, the pixels a cell spans.
  has cells: List of Text
  has columns: Integer
  has rows: Integer
  has cell_width: Integer
  has cell_height: Integer
end

public function glyph(colour: Colour) returns Text
  purpose: The character for the brightness of a colour, by the luma weights of Rec. 601.
  example: glyph(Colour(red: 0, green: 0, blue: 0)) is " "
  example: glyph(Colour(red: 255, green: 255, blue: 255)) is "@"
  example: glyph(Colour(red: 128, green: 128, blue: 128)) is "+"

  let luma be (colour.red * 299 + colour.green * 587 + colour.blue * 114).quotient(1000)
  return ramp.at((luma * ramp.length()).quotient(256)) otherwise "@"
end

public function span(start: Integer, stop: Integer, size: Integer, limit: Integer) returns Range
  purpose: The cells of the size whose middle lies from start to stop, clipped to the grid.
  example: span(start: 0, stop: 8, size: 10, limit: 32).to_list() is [0]
  example: span(start: 20, stop: 199, size: 10, limit: 20).length() is 18
  example: span(start: 6, stop: 9, size: 10, limit: 32).length() is 0

  let middle be size.quotient(2)
  let low be (start - middle + size - 1).at_least(0).quotient(size)
  if stop is less than middle then return from 1 to 0 end
  let high be (stop - middle).quotient(size).at_most(limit - 1)
  return from low to high
end

public function blank(columns: Integer, rows: Integer) returns Grid
  purpose: An empty grid of the size over the 320 by 200 screen.
  example: blank(columns: 32, rows: 20).cell_width is 10

  return Grid(
    cells: " ".repeat(columns * rows).characters(),
    columns: columns,
    rows: rows,
    cell_width: screen.width().quotient(columns),
    cell_height: screen.height().quotient(rows)
  )
end

public function drawn(grid: Grid, shape: Shape) returns Grid
  purpose: The grid with one shape drawn: a rectangle or a column filled, a label written.

  match shape
    when Rectangle(screen_x, screen_y, width, height, colour) then
      let across be span(
        start: screen_x,
        stop: screen_x + width - 1,
        size: grid.cell_width,
        limit: grid.columns
      )
      let down be span(
        start: screen_y,
        stop: screen_y + height - 1,
        size: grid.cell_height,
        limit: grid.rows
      )
      return filled(grid: grid, across: across, down: down, symbol: glyph(colour))
    when Label(screen_x, screen_y, text) then
      return lettered(
        grid: grid,
        column: screen_x.quotient(grid.cell_width),
        row: screen_y.quotient(grid.cell_height),
        text: text
      )
    otherwise return grid
  end
end

function filled(grid: Grid, across: Range, down: Range, symbol: Text) returns Grid
  purpose: The grid with every cell of the block of columns and rows set to the symbol.

  let mutable cells be grid.cells
  for each row in down
    for each column in across
      change cells to cells.with_at(index: row * grid.columns + column, item: symbol)
    end
  end
  return grid with cells: cells
end

function lettered(grid: Grid, column: Integer, row: Integer, text: Text) returns Grid
  purpose: The grid with the text written from a cell to the right, clipped at the end of its row.

  let mutable cells be grid.cells
  if row is at least grid.rows then return grid end
  for each letter, place in text.characters().with_index()
    if column + place is at least grid.columns then break end
    change cells to cells.with_at(index: row * grid.columns + column + place, item: letter)
  end
  return grid with cells: cells
end

public function text_view(frame: List of Shape, columns: Integer, rows: Integer) returns Text
  purpose: The frame drawn into a grid of characters, a line a row, each cell sampled at its middle.
  example: text_view(
    frame: [
      Rectangle(
        screen_x: 0,
        screen_y: 0,
        width: 160,
        height: 200,
        colour: Colour(red: 255, green: 255, blue: 255)
      )
    ],
    columns: 4,
    rows: 1
  ) is "@@  "

  let mutable grid be blank(columns: columns, rows: rows)
  for each shape in frame
    change grid to drawn(grid: grid, shape: shape)
  end
  let lines be
    for each row from 0 to rows - 1
    collect grid.cells.slice_text(start: row * columns, stop: row * columns + columns)
  return lines.join("\n")
end

test "a rectangle fills the cells its middles fall in, and a label writes over it"
  let white be Colour(red: 255, green: 255, blue: 255)
  let frame be [
    Rectangle(screen_x: 115, screen_y: 0, width: 9, height: 200, colour: white),
    Label(screen_x: 0, screen_y: 150, text: "HI", colour: white)
  ]
  check text_view(frame: frame, columns: 4, rows: 2) is " @  \nHI  "
end
