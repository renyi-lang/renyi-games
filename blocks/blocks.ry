module blocks
  purpose: Play the falling blocks at the host's screen, or without it: scripted input, text frames.

import game exposing State, Status
import std.console
import std.environment
import std.screen exposing Input
import text_view
import view

let frame_ms: Integer be 50
  purpose: The milliseconds one scripted frame lasts: twenty frames a second.

let demo_moves: List of Text be [
  "R1 W1 R1 W1 S1 W3",
  "F1 W1 S1 W3",
  "F1 W1 L1 W1 S1 W3",
  "R1 W1 R1 W1 R1 W1 R1 W1 S1 W3",
  "F1 W1 F1 W1 L1 W1 L1 W1 L1 W1 B6 S1 W3",
  "F1 W1 F1 W1 R1 W1 R1 W1 R1 W1 R1 W1 S1 W3",
  "L1 W1 L1 W1 L1 W1 S1 W3",
  "F1 W1 F1 W1 R1 W1 R1 W1 R1 W1 B4 S1 W3",
  "F1 W1 L1 W1 L1 W1 L1 W1 L1 W1 L1 W1 S1 W20"
]
  purpose: The demo with seed 1, a leg per piece: turn, slide, drop; three rows are cleared.

function demo_script() returns List of Text
  purpose: The demo's moves one by one, each a key and a frame count.

  return demo_moves.join(" ").split(" ")
end

public function controls_for(key: Text) returns Input
  purpose: The input of one scripted frame for a key; W and an unknown key wait.
  example: controls_for("F").forward is true
  example: controls_for("S").fire is true
  example: controls_for("L").turn_left is true
  example: controls_for("W").fire is false

  let idle be game.idle(frame_ms)
  match key
    when "F" then return idle with forward: true
    when "B" then return idle with backward: true
    when "L" then return idle with turn_left: true
    when "R" then return idle with turn_right: true
    when "S" then return idle with fire: true
    when "Q" then return idle with quit: true
    otherwise return idle
  end
end

public function expanded(script: List of Text) returns List of Input
  purpose: One input per frame for a script of moves such as L3 (left held three frames) or S.
  example: expanded(["F2", "S"]).length() is 3
  example: expanded(["L3"]).at(2) is controls_for("L")

  let mutable frames: List of Input be []
  for each move in script
    let times be move.drop(1).to_integer() otherwise 1
    for each key in move.take(1).repeat(times).characters()
      change frames to frames.append(controls_for(key))
    end
  end
  return frames
end

function show(state: State) needs console
  purpose: Print a frame as text with the state's summary line.

  console.print(text_view.text_view(view.render(state)))
  console.print(game.summary(state))
end

function play(script: List of Text, every: Integer) needs console
  purpose: Play a script on a new game with seed 1, printing every n-th frame as text (0 for none).

  let mutable state be game.new_game(1)
  for each controls in expanded(script)
    if state.status is not Playing then break end
    change state to game.step(state: state, controls: controls)
    if every is greater than 0 and state.frames remainder every is 0 then show(state) end
  end
  console.print(game.summary(state))
end

function play_live(seed: Integer) needs console, screen
  purpose: Play at the host's screen from the title: each frame drawn, its input stepping the game.

  let mutable state be game.title(seed)
  repeat until state.status is Quit
    let controls be screen.present(view.render(state))
    let next be game.step(state: state, controls: controls)
    if state.status is Playing and next.status is not Playing then
      console.print(game.summary(next))
    end
    change state to next
  end
end

public function main() needs console, environment, screen
  purpose: Run `play [seed]` (at the screen), `demo`, `steps L3 F1 S1 ...`, or show the first frame.

  let arguments be environment.arguments()
  let mode be arguments.at(0) otherwise "start"
  match mode
    when "play" then
      let seed be (arguments.at(1) otherwise "1").to_integer() otherwise 1
      play_live(seed)
    when "demo" then play(script: demo_script(), every: 10)
    when "steps" then play(script: arguments.drop(1), every: 0)
    otherwise show(game.new_game(1))
  end
end

test "the demo clears three rows with seed 1"
  let final be game.played(state: game.new_game(1), frames: expanded(demo_script()))
  check final.status is Playing
  check final.lines is 3
  check final.score is greater than 300
end

test "the first frame is a well with the first piece at its top, the title and the end their words"
  let lines be text_view.text_view(view.render(game.new_game(1))).lines()
  check lines.length() is 22
  check lines.at(1) is " BLOCKS     #....SS....# NEXT      "
  check lines.at(21) is "            ############           "
  let title be text_view.text_view(view.render(game.title(1)))
  check title.contains("PRESS F") and not title.contains("#....SS")
  let over be game.new_game(1) with status: Over
  check text_view.text_view(view.render(over)).contains("GAME OVER")
end

test "steps play a script: a slide, a turn and a hard drop"
  let final be game.played(state: game.new_game(1), frames: expanded(["L3", "F1", "S1"]))
  check final.frames is 5
  check game.summary(final) is "blocks: score 34, lines 0, level 1, frames 5"
end
